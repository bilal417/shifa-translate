<IfModule mod_rewrite.c>
  RewriteEngine On

  # Hostinger Git deployment checks out the repository root. Serve the
  # production Vite build kept in dist instead of the JSX source entrypoint.
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^index\.html$ dist/index.html [L]
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # Send client-side routes to React while leaving real repository files alone.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . dist/index.html [L]
</IfModule>
